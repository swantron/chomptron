# Copy to .env and fill in your values.

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite

# watchtron white-box tracing (set in Cloud Run service env).
# Tracing is a no-op unless WATCHTRON_OTLP_ENDPOINT is set.
WATCHTRON_OTLP_ENDPOINT=https://watch.swantron.com
WATCHTRON_TOKEN=your_watchtron_token_here
# Must match the registry expectedServiceName for chomptron.
WATCHTRON_SERVICE_NAME=chomptron-web
