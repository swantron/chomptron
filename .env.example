# Copy to .env and fill in your values.

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite

# MCP tool (POST /mcp) — caps how many Gemini calls the MCP path can trigger
# per rolling 24h, independent of the website's own traffic. Bounds the
# quota/cost an MCP client (Claude, ChatGPT, etc.) can add on top of the
# free-tier budget the live site already shares.
# MCP_DAILY_RECIPE_LIMIT=20
# REST_HOURLY_RECIPE_LIMIT=30
# MCP_BUDGET_FILE=/tmp/chomptron-mcp-budget.json

# watchtron white-box tracing (set in Cloud Run service env).
# Tracing is a no-op unless WATCHTRON_OTLP_ENDPOINT is set.
WATCHTRON_OTLP_ENDPOINT=https://watch.swantron.com
WATCHTRON_TOKEN=your_watchtron_token_here
# Must match the registry expectedServiceName for chomptron.
WATCHTRON_SERVICE_NAME=chomptron-web
